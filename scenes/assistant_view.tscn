[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/assistant_view.gd" id="1_asst"]

[node name="AssistantView" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_asst")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 6

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Assistant IA"

[node name="Subtitle" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.58, 0.65, 1)
theme_override_font_sizes/font_size = 13
text = "Créez, cochez ou supprimez vos tâches en langage naturel."

[node name="ActivityLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.73, 0.68, 1, 1)
theme_override_font_sizes/font_size = 13
text = "Analyse de la demande…"

[node name="ChatScroll" type="ScrollContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ChatList" type="VBoxContainer" parent="Margin/VBox/ChatScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="SuggestScroll" type="ScrollContainer" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
vertical_scroll_mode = 0

[node name="SuggestRow" type="HBoxContainer" parent="Margin/VBox/SuggestScroll"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="InputRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ChatInput" type="LineEdit" parent="Margin/VBox/InputRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Écrivez un message..."

[node name="SendButton" type="Button" parent="Margin/VBox/InputRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Envoyer"