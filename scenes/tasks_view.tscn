[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/tasks_view.gd" id="1_tasks"]

[node name="TasksView" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_tasks")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 6

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Mes tâches"

[node name="CountLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.58, 0.65, 1)
theme_override_font_sizes/font_size = 13
text = "0 à faire · 0 terminée"

[node name="ToolsRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="SearchInput" type="LineEdit" parent="Margin/VBox/ToolsRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Rechercher une tâche..."
clear_button_enabled = true

[node name="FilterButton" type="Button" parent="Margin/VBox/ToolsRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"GhostButton"
text = "Filtrer"

[node name="CreateButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "+ Nouvelle tâche"

[node name="ListArea" type="Control" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox/ListArea"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0

[node name="TaskList" type="VBoxContainer" parent="Margin/VBox/ListArea/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="EmptyState" type="VBoxContainer" parent="Margin/VBox/ListArea"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
alignment = 1

[node name="EmptyLabel" type="Label" parent="Margin/VBox/ListArea/EmptyState"]
layout_mode = 2
theme_override_colors/font_color = Color(0.42, 0.45, 0.52, 1)
theme_override_font_sizes/font_size = 15
text = "Aucune tâche ici.
Ajoutez-en une pour commencer."
horizontal_alignment = 1

[node name="FilterPopup" type="PopupPanel" parent="."]
unique_name_in_owner = true

[node name="PopupMargin" type="MarginContainer" parent="FilterPopup"]
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="FilterBox" type="VBoxContainer" parent="FilterPopup/PopupMargin"]
unique_name_in_owner = true
theme_override_constants/separation = 12